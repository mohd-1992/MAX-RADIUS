# ==============================================================================
# MAX RADIUS - Git Ignore Rules
# ==============================================================================

# Environments & Secrets
.env
.env.*
*.env
env/
.venv/
venv/

# Security Keys & Machine Identifiers
storage/machine_id
storage/instance_id
storage/keys/master_private_key.pem
storage/wg_bridge.sock
storage/l2tp/chap-secrets
storage/l2tp/pap-secrets

# Python & Cython Cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.c
build/
dist/
*.egg-info/

# Large Bundles, Dumps & Backups
export/
app_backup/
*.tar
*.tar.gz
*.gz
*.zip
*.bak*
*.old
*.orig
database/full_db.sql

# Runtime Storage & Data
storage/backups/*
!storage/backups/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
data/migration_cache/*
!data/migration_cache/.gitkeep
data/*
tmp/
.tmp/
.cache/
.pytest_cache/

# Database Binaries
*.db
*.sqlite
*.sqlite3
*.log

# IDE & OS Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
backup_card_designs/
storage/*.py

# Local secrets and verification artifacts
storage/license.key
storage/secrets/
storage/*_report*.md
pre_*_unstaged.patch
tests/

# Developer reference examples and reviewed scenarios (no runtime reports).
!.env.example
!tests/
tests/*
!tests/scenarios/
!tests/scenarios/*.md
!tests/test_portal_card_operations.py
!tests/test_import_quota_regression.py
!tests/test_voucher_pages.py
!tests/test_nas_shared_path.py
!tests/voucher_page_fixture.py
!tests/test_package_page.py
!tests/test_subscriber_admin_safety.py
!tests/test_subscriber_list_safety.py
!tests/portal_card_mariadb_regression.py
!tests/test_manager_pages.py
!tests/test_permission_visibility.py
!tests/visibility_fixture.py
!tests/manager_page_fixture.py
!tests/manager_mariadb_regression.py
reports/

!tests/test_reseller_ownership.py
!tests/reseller_ownership_mariadb.py
!tests/test_permission_catalog.py

!tests/test_quick_cards.py
!tests/quick_cards_mariadb.py

!tests/test_manager_wallet_receipts.py
!tests/test_import_release_consistency.py
!tests/test_userman_progress.py
!tests/test_userman_evidence.py
!tests/userman_rootfix_mariadb.py
!tests/userman_cancel_ui.cjs
!tests/run_userman_rootfix_lab.py
!tests/first_use_policy_integration.py
!tests/test_import_loyalty_fixes.py
!tests/import_loyalty_mariadb_regression.py
!tests/test_license_activation.py

# Instance data and private operational references must never enter Git.
/storage/*
!/storage/keys/
/storage/keys/*
!/storage/keys/master_public_key.pem
!/storage/backups/
/storage/backups/*
!/storage/backups/.gitkeep
!/storage/uploads/
/storage/uploads/*
!/storage/uploads/.gitkeep
!/storage/logs/
/storage/logs/*
!/storage/logs/.gitkeep
storage/userman-jobs/
private/
.private/
credentials/
.credentials/
**/*.private.*
**/*-private.*
**/*_private.*
**/credentials*.xml
**/credentials*.json
**/credential*.env
**/*private*.pem
**/*private*.key
**/license-instance.pem
**/id_rsa
**/id_ed25519
**/*.p12
**/*.pfx

# Distribution manifests are maintained in Git; runtime copies stay on the host.
/runtime-release.env
!/tests/test_batch_exports.py
/.install-backups/
