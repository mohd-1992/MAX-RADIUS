# ==============================================================================
# WISP FreeRADIUS & MikroTik Manager (MySQL Edition) - Environment Variables
# ==============================================================================

# Web Dashboard (Port 5090)
APP_ENV=production
DEBUG=False
SECRET_KEY=wisp-mysql-super-secret-key-32-chars
HOST=0.0.0.0
PORT=5090

# Database Connection (MariaDB / MySQL)
DB_TYPE=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_USER=radius
DB_PASSWORD=radpass
DB_NAME=radius_wisp
MYSQL_ROOT_PASSWORD=rootpass

# FreeRADIUS Dedicated / Test UDP Ports
RADIUS_AUTH_PORT=18120
RADIUS_ACCT_PORT=18130
RADIUS_COA_PORT=37990
RADIUS_SECRET_DEFAULT=testing123

# Persistent Storage Mounts
STORAGE_DIR=/app/storage
BACKUPS_DIR=/app/storage/backups
UPLOADS_DIR=/app/storage/uploads
LOGS_DIR=/app/storage/logs