#!/bin/bash
# ==============================================================================
# 🚀 MAX RADIUS - أداة الضبط التفاعلي لعنوان IP السيرفر والشبكة
# Ubuntu 24.04 LTS Network Configuration Utility (maxip)
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m' # No Color

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}❌ الرجاء تشغيل الأمر بصلاحيات الجذر (sudo maxip)${NC}"
    exit 1
fi

echo -e "${CYAN}${BOLD}"
echo "===================================================================="
echo "      🚀 MAX RADIUS - إعداد عنوان IP والشبكة لسيرفر أوبنتو"
echo "===================================================================="
echo -e "${NC}"

# 1. كشف كروت الشبكة الفيزيائية المتوفرة (استبعاد كروت دوكر والافتراضية)
INTERFACES=($(ip -o link show | awk -F': ' '{print $2}' | grep -Ev '^(lo|docker[0-9]*|br-[a-f0-9]*|veth[a-f0-9]*)'))

if [ ${#INTERFACES[@]} -eq 0 ]; then
    echo -e "${RED}❌ لم يتم العثور على أي كرت شبكة فيزيائي نشط!${NC}"
    exit 1
fi

# اختيار كرت الشبكة الافتراضي (الكرت المتصل حالياً بالإنترنت أو الأول في القائمة)
DEFAULT_IFACE=$(ip route | grep default | awk '{print $5}' | head -n1)
if [ -z "$DEFAULT_IFACE" ]; then
    DEFAULT_IFACE="${INTERFACES[0]}"
fi

echo -e "${YELLOW}📡 كرت الشبكة المستهدف: ${BOLD}${DEFAULT_IFACE}${NC}"
echo ""

# 2. طلب عنوان IP والـ CIDR
while true; do
    echo -e "${CYAN}🔹 أدخل عنوان IP المطلوب مع قناع الشبكة (مثال: 192.168.2.44/24):${NC}"
    read -p "IP/CIDR: " INPUT_IP_CIDR
    
    # تنظيف المدخلات
    INPUT_IP_CIDR=$(echo "$INPUT_IP_CIDR" | tr -d ' ')
    
    if [[ "$INPUT_IP_CIDR" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]]; then
        IP_ONLY=$(echo "$INPUT_IP_CIDR" | cut -d'/' -f1)
        CIDR_ONLY=$(echo "$INPUT_IP_CIDR" | cut -d'/' -f2)
        
        # التأكد من صحة الـ CIDR
        if [ "$CIDR_ONLY" -ge 8 ] && [ "$CIDR_ONLY" -le 30 ]; then
            break
        fi
    fi
    echo -e "${RED}⚠️ صيغة غير صحيحة! يرجى إدخال IP متبوعاً بقناع الشبكة مثل 192.168.2.44/24${NC}"
done

# 3. طلب عنوان البوابة الافتراضية (Gateway)
# استخراج بوابة مقترحة من نفس شبكة الـ IP
SUBNET_PREFIX=$(echo "$IP_ONLY" | cut -d'.' -f1-3)
SUGGESTED_GW="${SUBNET_PREFIX}.1"

while true; do
    echo ""
    echo -e "${CYAN}🔹 أدخل عنوان البوابة الافتراضية (Gateway) [مقترح: ${SUGGESTED_GW}]:${NC}"
    read -p "Gateway [${SUGGESTED_GW}]: " INPUT_GW
    
    INPUT_GW=$(echo "$INPUT_GW" | tr -d ' ')
    if [ -z "$INPUT_GW" ]; then
        INPUT_GW="$SUGGESTED_GW"
    fi
    
    if [[ "$INPUT_GW" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        break
    fi
    echo -e "${RED}⚠️ صيغة البوابة غير صحيحة! يرجى إدخال IP مثل 192.168.2.1${NC}"
done

# 4. طلب خوادم DNS (الافتراضي 8.8.8.8, 8.8.4.4 عند الضغط على Enter)
echo ""
echo -e "${CYAN}🔹 أدخل خوادم DNS مفصولة بفواصل [الافتراضي: 8.8.8.8, 8.8.4.4]:${NC}"
read -p "DNS Servers (اضغط Enter للافتراضي): " INPUT_DNS

INPUT_DNS=$(echo "$INPUT_DNS" | tr -d ' ')
if [ -z "$INPUT_DNS" ]; then
    DNS_ARRAY="[8.8.8.8, 8.8.4.4, 1.1.1.1]"
else
    # تحويل المدخلات إلى مصفوفة YAML
    DNS_LIST=$(echo "$INPUT_DNS" | sed 's/,/ /g')
    DNS_ARRAY="["
    for d in $DNS_LIST; do
        DNS_ARRAY="${DNS_ARRAY}${d}, "
    done
    DNS_ARRAY="${DNS_ARRAY%, }]"
fi

# 5. تطبيق إعدادات Netplan الرسمية لأوبنتو 24.04
echo ""
echo -e "${YELLOW}⚙️  جاري إنشاء ملف تكوين الشبكة وتطبيقه...${NC}"

# حفظ نسخة احتياطية من ملفات netplan السابقة
mkdir -p /etc/netplan/backup_maxip
cp -f /etc/netplan/*.yaml /etc/netplan/backup_maxip/ 2>/dev/null || true

# تعطيل ملفات netplan القديمة لتجنب التعارض
for f in /etc/netplan/*.yaml; do
    if [ -f "$f" ] && [ "$f" != "/etc/netplan/01-max-radius.yaml" ]; then
        mv "$f" "${f}.disabled" 2>/dev/null || true
    fi
done

# كتابة ملف Netplan القياسي الجديد
cat << EOF > /etc/netplan/01-max-radius.yaml
# Generated by MAX RADIUS (maxip) on $(date)
network:
  version: 2
  renderer: networkd
  ethernets:
    ${DEFAULT_IFACE}:
      dhcp4: no
      dhcp6: no
      addresses:
        - ${INPUT_IP_CIDR}
      routes:
        - to: default
          via: ${INPUT_GW}
      nameservers:
        addresses: ${DNS_ARRAY}
EOF

chmod 600 /etc/netplan/01-max-radius.yaml

# تطبيق الشبكة
netplan apply

echo ""
echo -e "${GREEN}${BOLD}====================================================================${NC}"
echo -e "${GREEN}${BOLD}  ✅ تم ضبط وتطبيق عنوان IP السيرفر بنجاح تام!${NC}"
echo -e "${GREEN}${BOLD}====================================================================${NC}"
echo ""
echo -e "  🌐 ${BOLD}عنوان السيرفر الجديد:${NC}      ${CYAN}${BOLD}${IP_ONLY}${NC}"
echo -e "  🚪 ${BOLD}البوابة الافتراضية:${NC}         ${INPUT_GW}"
echo -e "  🌍 ${BOLD}خوادم DNS:${NC}                 ${DNS_ARRAY}"
echo ""
echo -e "  🖥️  ${BOLD}رابط لوحة التحكم المباشر:${NC}  ${GREEN}${BOLD}http://${IP_ONLY}${NC} (بدون بورت)"
echo -e "  🔑 ${BOLD}بيانات الدخول:${NC}             اسم المستخدم: ${YELLOW}${BOLD}max${NC} | كلمة المرور: ${YELLOW}${BOLD}max123${NC}"
echo ""
echo -e "  📡 ${BOLD}أمر ميكروتيك لربط الراديوس:${NC}"
echo -e "  ${CYAN}/radius add address=${IP_ONLY} secret=123 service=hotspot,ppp authentication-port=1812 accounting-port=1813 timeout=3000ms${NC}"
echo ""
echo "===================================================================="
